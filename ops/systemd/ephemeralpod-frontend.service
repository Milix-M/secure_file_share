[Unit]
Description=Ephemeral Pod Frontend (Astro preview server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ephemeralpod
Group=ephemeralpod
WorkingDirectory=/opt/ephemeralpod/frontend
EnvironmentFile=/etc/ephemeralpod/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run preview -- --host 0.0.0.0 --port 4321
Restart=on-failure
RestartSec=5
# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc
ReadWritePaths=/opt/ephemeralpod/frontend/.cache
AmbientCapabilities=
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
