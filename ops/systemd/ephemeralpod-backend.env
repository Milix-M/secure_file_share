# Backend environment variables for Ephemeral Pod
EPHEMERALPOD_ADDR=:8080
EPHEMERALPOD_STORAGE_PATH=/dev/shm/ephemeralpod
EPHEMERALPOD_STORAGE_CAPACITY_MB=12288
EPHEMERALPOD_MAX_UPLOAD_SIZE_MB=200
EPHEMERALPOD_UPLOAD_TTL=8h
EPHEMERALPOD_CLEANUP_INTERVAL=1m
EPHEMERALPOD_WS_IDLE_PING=30s
EPHEMERALPOD_ALLOWED_ORIGINS=https://your.frontend.domain
